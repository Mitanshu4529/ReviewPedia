# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/reviewpedia

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_string
FRONTEND_URL=

# AI Services (Google Gemini 2.5 Flash for Autonomous Agents)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Delivery (Resend API)
RESEND_API_KEY=your_resend_api_key_here
DEMO_RECIPIENT_EMAIL=

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS: extra browser origins allowed to call the API (comma separated).
# localhost dev servers, reviewpedia.co.in and FRONTEND_URL are always allowed.
ALLOWED_ORIGINS=
# Set to true to also allow every *.vercel.app preview deployment (any Vercel-hosted site matches).
ALLOW_VERCEL_PREVIEWS=false

# Tests (npm test) always use this dedicated database, never MONGODB_URI. The name must contain "test".
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/reviewpedia_test_db

# Public map summary (POST /api/agents/hexagon-summary): how many summaries per hour the model
# may be asked for in total, across all visitors. Default 200.
# PUBLIC_SUMMARY_HOURLY_BUDGET=200
